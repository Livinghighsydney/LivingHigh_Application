# Backend environment — copy to .env and fill in.

# Server
PORT=4000
# Allowed origin for CORS (the Next.js frontend)
FRONTEND_ORIGIN=http://localhost:3000
# Public URL of the frontend, used to build gallery links in the PDF
APP_URL=http://localhost:3000

# Supabase (service-role key is server-only — never ship to the browser)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Resend
RESEND_API_KEY=
REPORT_FROM_EMAIL=
REPORT_OFFICE_EMAIL=
