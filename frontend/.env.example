# Frontend environment — copy to .env.local and fill in.
# Only NEXT_PUBLIC_* values reach the browser; never put secrets here.

# Supabase (public anon/publishable key only)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public URL of this app (used for gallery links)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Backend API base URL (the Express server that generates reports)
NEXT_PUBLIC_BACKEND_URL=http://localhost:4000
